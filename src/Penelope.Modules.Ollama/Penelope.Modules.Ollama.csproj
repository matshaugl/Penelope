<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Penelope.Modules.Ollama</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Penelope.Abstractions\Penelope.Abstractions.csproj" />
    <InternalsVisibleTo Include="Penelope.Host.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CopyToPlugins)' != 'false'">
    <PropertyGroup>
      <PluginDir>$(MSBuildThisFileDirectory)..\..\plugins\ollama\</PluginDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PluginDir)Penelope.Modules.Ollama.dll" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\manifest.json" DestinationFiles="$(PluginDir)manifest.json" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog.json" DestinationFiles="$(PluginDir)catalog.json" />
  </Target>
</Project>
